{
  "name": "nudeui",
  "version": "0.0.1",
  "description": "",
  "main": "elements/index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "npx postcss \"elements/**/*.postcss\" --base . --dir . --ext .css --config postcss.config.cjs",
    "build:html": "npx docspire",
    "build": "npm run build:css && npm run build:html",
    "watch:css": "npx postcss \"elements/**/*.postcss\" --base . --dir . --ext .css --config postcss.config.cjs --watch",
    "watch:html": "npx docspire --serve",
    "watch": "npx concurrently -n w: npm:watch:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leaverou/nudeui.git"
  },
  "keywords": [
    "CSS",
    "forms"
  ],
  "author": "Lea Verou",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/leaverou/nudeui/issues"
  },
  "homepage": "https://github.com/leaverou/nudeui#readme",
  "devDependencies": {
    "concurrently": "^7.6.0",
    "docspire": "github:docspired/docspire#claude/component-readme-docspire-am2h5g",
    "postcss": "^8.3.9",
    "postcss-cli": "^9.0.1",
    "postcss-nesting": "^8.0.1"
  }
}
