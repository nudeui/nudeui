{
  "name": "nudeui",
  "version": "0.0.2",
  "description": "",
  "main": "components/index.js",
  "type": "module",
  "exports": {
    ".": "./components/index.js",
    "./style.css": "./components/index.css",
    "./*": "./components/*/*.js",
    "./*/style.css": "./components/*/style.css"
  },
  "scripts": {
    "release": "npm whoami >/dev/null 2>&1 || npm login && release-it",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "npx postcss \"components/**/*.postcss\" --base . --dir . --ext .css --config postcss.config.cjs",
    "build:html": "npx docspire",
    "build": "npm run build:css && npm run build:html",
    "watch:css": "npx postcss \"components/**/*.postcss\" --base . --dir . --ext .css --config postcss.config.cjs --watch",
    "watch:html": "npx docspire --serve",
    "watch": "npx concurrently -n w: npm:watch:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leaverou/nudeui.git"
  },
  "keywords": [
    "CSS",
    "forms"
  ],
  "author": "Lea Verou",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/leaverou/nudeui/issues"
  },
  "homepage": "https://github.com/leaverou/nudeui#readme",
  "devDependencies": {
    "concurrently": "^7.6.0",
    "docspire": "^0.0.3",
    "postcss": "^8.3.9",
    "postcss-cli": "^9.0.1",
    "postcss-nesting": "^8.0.1",
    "release-it": "^21.0.2"
  }
}
